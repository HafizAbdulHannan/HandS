{
  "expo": {
    "name": "HandS",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#E6E9EF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "App requires background location to track trips with your partner.",
        "NSLocationWhenInUseUsageDescription": "App requires location to show your position on the map."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.hafizabdulhannan.frontend",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      "expo-location",
      "expo-notifications",
      "react-native-agora",
      [
        "react-native-widget-extension",
        {
          "name": "MemoryWidget",
          "widgetPath": "widgets",
          "bundleIdentifier": "com.hafizabdulhannan.frontend.widget"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "07b11450-9a10-4246-988c-084130decb91"
      }
    }
  }
}
